# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
.uv/

# Test caches
.pytest_cache/

# Results (large CSVs; track summaries, not raw runs)
manuscript/results/*.csv
R/results/*.log

# Vendored third-party replication package (618M of data; lives in Dropbox, not git)
manuscript/replication_AssessingPlanB/

# Paper build artifacts (extensions are committed, not ignored)
manuscript/paper/_freeze/
manuscript/paper/.quarto/
manuscript/paper/*_files/
manuscript/paper/*.html
manuscript/paper/*.pdf
manuscript/paper/tmp/
manuscript/paper/*.tex

# uv build cache inside python/
python/.venv/

# Root-level Quarto output (renders of .md files)
*.html
*.pdf
*_files/

# ...except the built preprint, so the repo ships a readable PDF. This has to
# sit after the broad *.pdf rule above, since later patterns win.
!manuscript/paper/sudo_paper.pdf

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Claude Code session-local state
.claude/

# Internal notes and generated summaries (not published)
/archive/
# private review memos, wherever they live
*_review.md
manuscript/open_problems.md
R/theory_rubin_check.R
R/theory_rubin_check_ml.R
R/results/theory_rubin_check.csv
